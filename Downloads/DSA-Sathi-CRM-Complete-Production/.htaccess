# DSA Sathi CRM — Production Apache / Hostinger / cPanel Configuration

DirectoryIndex index.html login.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Block direct access to sensitive backend files
  RewriteRule ^(\.env|\.git|users\.json|data/|crm_db\.json) - [F,L]

  # 2. Reverse proxy API endpoints to Node.js backend if mod_proxy is active
  <IfModule mod_proxy.c>
    RewriteRule ^api/(.*)$ http://127.0.0.1:3000/api/$1 [P,L]
  </IfModule>

  # 3. Route /api/ to PHP API handler when direct Apache handles it
  RewriteRule ^api/(.*)$ api/index.php [QSA,L]

  # 4. If requested filename or directory exists, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 5. Explicit HTML Page Route Mappings (GET requests only)
  RewriteCond %{REQUEST_METHOD} GET
  RewriteRule ^login/?$ login.html [L,QSA]
  RewriteCond %{REQUEST_METHOD} GET
  RewriteRule ^crm/?$ crm.html [L,QSA]
  RewriteCond %{REQUEST_METHOD} GET
  RewriteRule ^onboarding/?$ onboarding.html [L,QSA]
  RewriteCond %{REQUEST_METHOD} GET
  RewriteRule ^index/?$ index.html [L,QSA]

  # 6. SPA Route Fallbacks for CRM Dashboard & Sub-modules (GET requests only)
  RewriteCond %{REQUEST_METHOD} GET
  RewriteRule ^crm/.* crm.html [L,QSA]
  RewriteCond %{REQUEST_METHOD} GET
  RewriteRule ^(dashboard|overview|ask-ai|setup|team|reports|finance|hr|marketing|wallet|calculators|verifications|utility)/?$ crm.html [L,QSA]

  # 7. Default root and fallback routing (GET requests only - NEVER rewrite API or non-GET)
  RewriteRule ^$ index.html [L,QSA]
  RewriteCond %{REQUEST_METHOD} GET
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteRule ^.*$ index.html [L]
</IfModule>

# Note: CORS headers are managed dynamically by the backend to support credentials safely.
